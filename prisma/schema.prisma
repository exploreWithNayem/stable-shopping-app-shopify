// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// The URL is an environment variable, not a literal, so a deployment can point
// at a durable path or a managed database instead of a file inside the
// container image — a hardcoded `file:dev.sqlite` is recreated empty on every
// redeploy. Relative file paths are resolved against this file's directory, so
// `DATABASE_URL="file:dev.sqlite"` is the local default and matches what this
// used to hardcode.
//
// Going to Postgres for production also needs `provider = "postgresql"` here
// (Prisma requires a literal, so it cannot be an env var) and a fresh migration
// history — see CLAUDE.md Phase 15.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// One row per installed store. Created on first authenticated admin request.
model Shop {
  id                String    @id @default(cuid())
  domain            String    @unique // my-store.myshopify.com
  plan              String    @default("free") // free | standard | enterprise
  subscriptionId    String? // Shopify AppSubscription GID, null on the free plan
  billingCycleStart DateTime? // anchor for the monthly quota window
  currencyCode      String? // shop currency, cached for money formatting
  storefrontToken   String? // delegated Storefront API token, provisioned on demand
  installedAt       DateTime  @default(now())
  uninstalledAt     DateTime?
  settings          Json? // global widget defaults, see Phase 13

  offers    Offer[]
  overrides Override[]
  usage     UsagePeriod[]
  events    RecommendationEvent[]
  daily     AnalyticsDaily[]
}

/// A merchant-authored offer: which products it shows on, what it recommends,
/// and how that reads on the storefront.
///
/// Sits *above* Override rather than replacing it. Publishing an offer writes one
/// Override per target product and syncs each metafield, so the whole Phase 6/8
/// storefront path is reused unchanged — the theme block does not know offers
/// exist. Unpublishing removes those rows again.
///
/// `targets` and `items` are Json rather than relations for the same reason
/// Override.items is: they are short, ordered, merchant-curated lists that are
/// always read whole, and a join table would buy nothing.
model Offer {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String // internal reference, shown only in the admin
  placement   String    @default("PRODUCT_PAGE") // PRODUCT_PAGE (the only built one)
  offerType   String    @default("cross_sell") // cross_sell | volume_discount | frequently_bought_together | product_add_on
  title       String    @default("")
  badge       String    @default("")
  buttonText  String    @default("Add")
  countdown   Boolean   @default(false)
  /// How the countdown ends: "fixed" is a per-visitor duration in minutes that
  /// starts on first view, "date" is one absolute deadline for everybody.
  countdownMode    String   @default("fixed") // fixed | date
  countdownMinutes Int      @default(60)
  countdownEndsAt  DateTime? // "date" mode only
  countdownTitle   String   @default("Hurry up! Offer expires in {{timer}}")
  /// Which product pages the offer appears on.
  ///
  /// "products" is the original behaviour and the only one that writes a per-product
  /// Override row: the merchant names the pages. "all" and "collections" are
  /// shop-scope — they are published to one shop-owned metafield the app embed reads
  /// on every product page, because writing a row per product would mean thousands
  /// of metafield writes and would consume the per-product plan allowance instantly.
  triggerMode        String @default("products") // all | products | collections
  /// Nullable and with **no** `@default`, unlike every other new column here.
  ///
  /// `Json @default("[]")` looks right and generates `DEFAULT []` on SQLite —
  /// unquoted, where `[...]` is identifier-quoting syntax, so every pre-existing row
  /// got an **empty string** and `prisma.offer.findMany()` then died with
  /// "Inconsistent column data: EOF while parsing a value". Null is a value Prisma
  /// can actually read, every write sends a real array, and every read already
  /// coalesces with `?? []`.
  triggerCollections Json? // [{ id, handle, title }] for "collections"
  excludeProducts    Json? // product pages the offer must not appear on
  excludeCollections Json?
  /// Where the recommended products come from. "specific" is the curated `items`
  /// list; "automated" leaves it to Shopify's own recommendations, fetched on the
  /// storefront with the intent below.
  offerSource String @default("specific") // specific | automated
  offerIntent String @default("related") // related | complementary
  /// Storefront filtering, applied by reco.js.
  hideInCart         Boolean @default(false)
  hideTriggerProduct Boolean @default(true)
  showQuantityPicker Boolean @default(false)
  /// Reserved. Only "none" is implemented — a real discount needs a Shopify
  /// Functions discount extension, which this app does not have.
  discountType String @default("none")
  /// Where on the page the app embed injects the offer. Null means "use the
  /// built-in fallback chain in reco.js", which covers Dawn-family themes; a
  /// merchant on an unusual theme sets their own CSS selector.
  anchorSelector String?
  anchorPosition String  @default("after") // before | after
  targets     Json // [{ id, handle, title }] — the product pages it appears on
  items       Json // [{ id, handle, title }] — what it recommends
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shopId, status])
  @@index([shopId, updatedAt])
}

/// A manual recommendation list that replaces the Shopify-generated one.
/// Mirrored to the product's $app:reco_overrides metafield on every write.
model Override {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId     String // numeric Shopify product ID
  productTitle  String
  productHandle String
  placement     String    @default("pdp") // pdp | checkout | both
  enabled       Boolean   @default(true)
  items         Json // [{ id, handle, title, position }]
  /// Copy an Offer projected onto this row: { title, badge, buttonText, countdown }.
  /// Null for rows created straight from the recommendations page, where the theme
  /// block's own settings supply the wording.
  ///
  /// Denormalised on purpose. This row is what gets written to the metafield, so
  /// it has to carry everything the metafield needs — otherwise the Settings
  /// re-sync, which reads rows and not offers, would silently drop the copy.
  presentation  Json?
  /// The Offer that wrote this row, when one did.
  ///
  /// Without it, taking an offer down could only look at the targets the offer
  /// *currently* names — so a merchant who switched a published offer's trigger, or
  /// deleted it after switching, left rows and metafields behind that nothing could
  /// find, and those pages went on rendering the offer forever. Ownership transfers
  /// on write: if a second offer publishes onto the same product, the row is that
  /// offer's, and taking the first one down must not remove it.
  offerId       String?
  syncedAt      DateTime? // last successful metafield sync
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([shopId, productId, placement])
  @@index([shopId, offerId])
  @@index([shopId, enabled])
}

/// Quota window. One row per shop per billing month.
model UsagePeriod {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  servedCount Int      @default(0)
  quota       Int // snapshot of the plan limit; -1 = unlimited
  planAtStart String

  @@unique([shopId, periodStart])
}

/// Raw, append-only tracking events. Rolled up into AnalyticsDaily and pruned
/// by the retention job (Phase 9).
model RecommendationEvent {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type            String // served | impression | click | add_to_cart | purchase
  sourceProductId String // the PDP / cart product the widget was shown on
  recoProductId   String? // the recommended product; null for `served`
  placement       String // pdp | checkout | thank_you | order_status
  source          String // shopify | override
  sessionId       String?
  clientId        String?  @unique // client-generated idempotency key
  orderId         String?
  revenue         Decimal?
  createdAt       DateTime @default(now())

  @@index([shopId, type, createdAt])
  @@index([shopId, recoProductId, type])
  // Backs the per-source metrics on the recommendations list page, which asks
  // "how did the widget on THIS product's page perform".
  @@index([shopId, sourceProductId, type])
}

/// Pre-aggregated daily metrics. Every admin analytics read hits this table,
/// never the raw event table.
model AnalyticsDaily {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date        DateTime // UTC midnight
  productId   String // the recommended product
  placement   String
  served      Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  addToCarts  Int      @default(0)
  purchases   Int      @default(0)
  revenue     Decimal  @default(0)

  @@unique([shopId, date, productId, placement])
  @@index([shopId, date])
}
