{%- comment -%}
  Popular products — a merchandising block the merchant can drop on any page.

  Unlike the Recommendations block this has no source product and no
  personalisation: it renders a collection, server-side, in Liquid. That is why
  it works on the home page, a collection page, the cart, or anywhere else the
  theme accepts app blocks, and why it never touches the app's backend to
  render.

  "Best selling" means the collection's own sort order. Liquid exposes no sales
  figures, so the merchant sets the collection to Best selling once in
  Products → Collections and every render follows it.

  Nothing here counts against the recommendation quota — see the `data-reco-serve`
  attribute below.
{%- endcomment -%}

{%- liquid
  assign limit = block.settings.limit

  assign source = block.settings.collection
  if source == blank
    assign source = collections['all']
  endif

  comment
    Unpaginated, Liquid hands over the first 50 products of a collection, so the
    re-sorts below order those 50 rather than the whole collection. Fine for a
    row of up to 24 cards; noted on the setting.

    Do not write a paginate tag out in full anywhere inside this liquid tag —
    its closing brace ends the liquid tag early, and the error surfaces as
    "'comment' tag was never closed".
  endcomment
  case block.settings.sort_by
    when 'newest'
      assign candidates = source.products | sort: 'created_at' | reverse
    when 'price_asc'
      assign candidates = source.products | sort: 'price'
    when 'price_desc'
      assign candidates = source.products | sort: 'price' | reverse
    when 'title'
      assign candidates = source.products | sort: 'title'
    else
      assign candidates = source.products
  endcase

  comment
    Not `| default: 'key' | t` — that pipes the merchant's own heading through
    the translation filter and renders "translation missing".
  endcomment
  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'popular.heading' | t
  endif
-%}

{%- capture cards -%}
  {%- assign rendered = 0 -%}
  {%- for item in candidates -%}
    {%- if rendered >= limit -%}
      {%- break -%}
    {%- endif -%}

    {%- comment -%} On a product page, don't recommend the page you are on. {%- endcomment -%}
    {%- if block.settings.exclude_current and product and item.id == product.id -%}
      {%- continue -%}
    {%- endif -%}

    {%- if block.settings.hide_sold_out and item.available == false -%}
      {%- continue -%}
    {%- endif -%}

    {%- render 'reco-card', reco: item, block: block -%}
    {%- assign rendered = rendered | plus: 1 -%}
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%}
  Three attributes below carry the behaviour that separates this block from the
  recommendations one. They are documented here rather than beside the
  attributes themselves, because a whitespace-stripping comment placed between
  two attributes eats the space holding them apart and fuses them.

    data-reco-serve="false"       engagement only — reco.js sends impression,
                                  click and add_to_cart but never `served`, so
                                  a home page row costs no quota.
    data-reco-server-rendered     already filled from Liquid; stops reco.js
                                  running its Ajax fallback, which needs a
                                  source product this block does not have.
    data-reco-source-product="*"  the sentinel for "no one source product".
{%- endcomment -%}

{%- if cards != blank -%}
  <div
    class="reco reco--{{ block.settings.layout }} reco--align-{{ block.settings.text_align }}"
    data-reco-block
    data-reco-placement="popular"
    data-reco-serve="false"
    data-reco-server-rendered="true"
    data-reco-source-product="*"
    data-reco-source="shopify"
    data-reco-limit="{{ limit }}"
    data-reco-atc="{{ block.settings.atc_behavior }}"
    data-reco-autoplay="{{ block.settings.autoplay }}"
    data-reco-autoplay-speed="{{ block.settings.autoplay_speed }}"
    style="
      --reco-columns-desktop: {{ block.settings.columns_desktop }};
      --reco-columns-mobile: {{ block.settings.columns_mobile }};
      --reco-accent: {{ block.settings.accent_color }};
      --reco-padding-top: {{ block.settings.padding_top }}px;
      --reco-padding-bottom: {{ block.settings.padding_bottom }}px;
      --reco-ratio: {% case block.settings.image_ratio %}{% when 'square' %}1/1{% when 'portrait' %}3/4{% else %}auto{% endcase %};
      --reco-card-border: {% if block.settings.show_border %}1px{% else %}0px{% endif %};
    "
    {{ block.shopify_attributes }}
  >
    {%- if heading != blank -%}
      <h2 class="reco__heading reco__heading--{{ block.settings.heading_size }}">
        {{ heading }}
      </h2>
    {%- endif -%}

    <div class="reco__viewport">
      <div class="reco__track" data-reco-track>
        {{ cards }}
      </div>
    </div>

    {%- if block.settings.layout == 'slider' -%}
      <div class="reco__nav" data-reco-nav hidden>
        <button
          type="button"
          class="reco__nav-button"
          data-reco-prev
          aria-label="{{ 'recommendations.previous' | t }}"
        >
          &#8249;
        </button>
        <button
          type="button"
          class="reco__nav-button"
          data-reco-next
          aria-label="{{ 'recommendations.next' | t }}"
        >
          &#8250;
        </button>
      </div>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  {%- comment -%}
    An empty collection renders nothing on the live storefront, but a merchant
    staring at a blank space in the editor needs to know why.
  {%- endcomment -%}
  <div class="reco reco--empty" {{ block.shopify_attributes }}>
    <p>{{ 'popular.empty' | t }}</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Popular products",
  "target": "section",
  "stylesheet": "reco.css",
  "javascript": "reco.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to use all products."
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Sort by",
      "info": "Best selling follows the collection's own sort order — set it to Best selling under Products > Collections. Other options sort the first 50 products of the collection.",
      "default": "best_selling",
      "options": [
        { "value": "best_selling", "label": "Best selling (collection order)" },
        { "value": "newest", "label": "Newest first" },
        { "value": "price_asc", "label": "Price: low to high" },
        { "value": "price_desc", "label": "Price: high to low" },
        { "value": "title", "label": "Alphabetical" }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "exclude_current",
      "label": "Hide the product being viewed",
      "info": "Only applies when the block is placed on a product page.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold out products",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" },
        { "value": "list", "label": "List" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "square",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "natural", "label": "Natural" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hover_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show card border",
      "default": false
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "md",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ]
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show original price when on sale",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "info": "Shows the product rating if a reviews app has set one.",
      "default": false
    },
    {
      "type": "header",
      "content": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart button",
      "default": true
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "select",
      "id": "atc_behavior",
      "label": "After adding to cart",
      "default": "ajax",
      "options": [
        { "value": "ajax", "label": "Stay on the page" },
        { "value": "open_drawer", "label": "Open the cart drawer" },
        { "value": "redirect_cart", "label": "Go to the cart" }
      ]
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" },
        { "value": "text", "label": "Text" }
      ]
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-advance slider",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds between slides",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32,
      "unit": "px"
    }
  ]
}
{% endschema %}
