{%- liquid
  assign mode = block.settings.source
  assign limit = block.settings.limit

  comment
    One block, two sources — both recommendations, both product-page only.

    - custom   per-product lists from the $app:reco_overrides metafield,
               falling back to Shopify's own recommendations in the browser.
    - related  Shopify's own recommendations, always — no override is consulted,
               and nothing renders here: reco.js fetches the list from the Ajax
               API.

    Both answer "what goes with this product", so both beacon `served` and cost
    quota (CLAUDE.md 3.3). Both need `product`, which is why this block can
    declare enabled_on templates: ["product"] and never offer itself on a
    template where it cannot work. The merchandising sources — Popular,
    Collection products, Recently viewed — live in `product-showcase.liquid`,
    which goes on any template and owns the Collection picker.

    App-owned metafields live in the reserved namespace app--{app_id}. Liquid
    reaches it through the "$app" reserved prefix used as a bracket key.
    `metafields.app` looks for a literal namespace named "app", finds nothing,
    and resolves to nil — silently dropping every override to the fallback.
  endcomment

  if mode == 'custom'
    assign overrides = product.metafields["$app"].reco_overrides.value
  endif
-%}

{%- capture cards -%}
  {%- if mode == 'custom' and overrides.items -%}
    {%- comment -%}
      all_products is capped at 20 lookups per page; an override list holds at
      most 12, so this stays clear of the ceiling.
    {%- endcomment -%}
    {%- for item in overrides.items limit: limit -%}
      {%- assign reco = all_products[item.handle] -%}
      {%- if reco.id -%}
        {%- render 'reco-card', reco: reco, block: block -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- render 'reco-panel', block: block, mode: mode, cards: cards, collection_blank: false -%}

{% schema %}
{
  "name": "Smart Recommendations",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "javascript": "reco.js",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Select Source",
      "options": [
        {
          "value": "custom",
          "label": "Custom recommendations"
        },
        {
          "value": "related",
          "label": "Related products"
        }
      ],
      "default": "custom"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "list",
          "label": "List"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "info": "Custom lists hold up to 12 products."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "natural",
          "label": "Natural"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "hover_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show card border",
      "default": false
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "md",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ]
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show original price when on sale",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "info": "Shows the product rating if a reviews app has set one.",
      "default": false
    },
    {
      "type": "header",
      "content": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart button",
      "default": true
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "select",
      "id": "atc_behavior",
      "label": "After adding to cart",
      "default": "ajax",
      "options": [
        {
          "value": "ajax",
          "label": "Stay on the page"
        },
        {
          "value": "open_drawer",
          "label": "Open the cart drawer"
        },
        {
          "value": "redirect_cart",
          "label": "Go to the cart"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-advance slider",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds between slides",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32,
      "unit": "px"
    }
  ]
}
{% endschema %}
