{%- comment -%}
  Easy Recommendation — app embed.

  Publishes runtime config for reco.js. Deliberately does not load the script
  itself: the recommendations block declares it, so the script is present
  wherever a block is, whether or not the merchant enabled this embed.

  reco.js reads this object at call time rather than load time, so the two can
  arrive in either order.
{%- endcomment -%}

<script>
  window.EasyReco = window.EasyReco || {};
  window.EasyReco.config = {
    proxy: "/apps/easy-reco",
    shop: {{ shop.permanent_domain | json }},
    moneyFormat: {{ shop.money_format | strip_html | json }},
    enabled: {% if block.settings.enable_tracking %}true{% else %}false{% endif %},
    strings: {
      addToCart: {{ 'recommendations.add_to_cart' | t | json }},
      added: {{ 'recommendations.added' | t | json }},
      soldOut: {{ 'recommendations.sold_out' | t | json }},
      chooseOptions: {{ 'recommendations.choose_options' | t | json }},
      error: {{ 'recommendations.error' | t | json }}
    }
  };
</script>

{%- comment -%}
  Recently viewed history.

  Recorded here because the embed runs on every page, whereas reco.js only
  loads where a block is placed — a shopper can browse a dozen products without
  ever hitting one. Handles only: the Recently viewed block re-fetches live
  product JSON, so nothing stored here can go stale.
{%- endcomment -%}
{%- if template.name == 'product' and product -%}
  <script>
    (function () {
      try {
        var KEY = 'easy-reco:recently-viewed';
        var MAX = 20;
        var handle = {{ product.handle | json }};
        var list = JSON.parse(window.localStorage.getItem(KEY) || '[]');
        if (!Array.isArray(list)) list = [];
        list = list.filter(function (item) {
          return typeof item === 'string' && item !== handle;
        });
        list.unshift(handle);
        window.localStorage.setItem(KEY, JSON.stringify(list.slice(0, MAX)));
      } catch (error) {
        // Private browsing, a full quota, or storage disabled — the block just
        // stays empty. Never break the page over a merchandising nicety.
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Easy Recommendation",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_tracking",
      "label": "Track recommendation performance",
      "info": "Turn off to stop recording impressions, clicks and add to carts. Recommendations keep working.",
      "default": true
    }
  ]
}
{% endschema %}
