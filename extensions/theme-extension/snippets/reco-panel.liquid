{%- comment -%}
  The block chrome, shared by every product block in this extension: wrapper,
  data-attributes, heading, track, slider nav, client-render template and the
  theme-editor empty state.

  Two blocks exist because they answer to different templates and different
  fields. `recommendations.liquid` is PDP-only — Custom and Related both need a
  product, so it declares `enabled_on: templates: ["product"]`, which a block
  carrying Popular or Recently viewed could never do. `product-showcase.liquid`
  goes anywhere and owns the Collection picker, which has to be a real
  `"type": "collection"` resource input and therefore cannot be hidden
  (CLAUDE.md 7.3).

  Everything they share lives here rather than being copied: only the schema
  JSON is forced to duplicate, and a test compares the copies.

  Accepts:
    block            - the block object (required)
    mode             - custom | related | popular | collection | recently_viewed
    cards            - the captured server-rendered card markup
    collection_blank - true when a collection-driven mode resolved to nothing,
                       which separates "no collections in this store" from
                       "this collection is empty" in the editor hint

  `render` isolates assigned variables but not global objects, so `product`,
  `request` and the theme's settings are still reachable here.
{%- endcomment -%}

{%- liquid
  comment
    Not `| default: 'key' | t` — that pipes the merchant's own heading through
    the translation filter and renders "translation missing".
  endcomment
  assign heading = block.settings.heading

  assign add_label = block.settings.add_to_cart_label
  if add_label == blank
    assign add_label = 'recommendations.add_to_cart' | t
  endif

  assign background = block.settings.background_color
  assign has_background = false
  if background != blank and background.alpha > 0
    assign has_background = true
  endif

  assign limit = block.settings.limit

  comment
    Which sources need the browser to finish the job: custom with no override
    falls back to Shopify's Ajax API, related always goes there, and recently
    viewed has nothing to render server-side at all.
  endcomment
  assign client_rendered = false
  if mode == 'recently_viewed' or mode == 'related'
    assign client_rendered = true
  elsif mode == 'custom' and cards == blank
    assign client_rendered = true
  endif

  assign renderable = false
  if mode == 'recently_viewed'
    assign renderable = true
  elsif mode == 'custom' and product
    assign renderable = true
  elsif mode == 'related' and product
    assign renderable = true
  elsif mode == 'popular' and cards != blank
    assign renderable = true
  elsif mode == 'collection' and cards != blank
    assign renderable = true
  endif
-%}

{%- if renderable -%}
  {{ 'reco.css' | asset_url | stylesheet_tag }}

  <div
    class="reco reco--{{ block.settings.layout }} reco--align-{{ block.settings.text_align }}{% if has_background %} reco--has-background{% endif %}"
    data-reco-block
    data-reco-limit="{{ limit }}"
    data-reco-atc="{{ block.settings.atc_behavior }}"
    data-reco-autoplay="{{ block.settings.autoplay }}"
    data-reco-autoplay-speed="{{ block.settings.autoplay_speed }}"
    data-reco-server-rendered="{% if client_rendered %}false{% else %}true{% endif %}"
    {%- if mode == 'custom' %}
      data-reco-placement="pdp"
      data-reco-source-product="{{ product.id }}"
      data-reco-source="{% if cards != blank %}override{% else %}shopify{% endif %}"
      {%- comment -%}
        Fixed, not a setting. The `intent` picker was removed on 2026-08-19: it
        only ever applied to this source's fallback, and "Related products" set
        to Complementary read as a contradiction next to the Related source.
        `complementary` is still supported end to end by the proxy and the
        engine — it is simply not chosen from the theme (CLAUDE.md 7.2).
      {%- endcomment -%}
      data-reco-intent="related"
    {%- elsif mode == 'related' %}
      {%- comment -%}
        Its own placement rather than `pdp`: a Custom row and a Related row on
        the same product page are two recommendations, and sharing a placement
        would let the 30-minute serve dedupe swallow one of them.

        `source` is always shopify — this source never reads the override.
      {%- endcomment -%}
      data-reco-placement="related"
      data-reco-source-product="{{ product.id }}"
      data-reco-source="shopify"
      data-reco-intent="related"
    {%- else %}
      {%- comment -%}
        Merchandising, not recommendation: reports engagement but emits no
        `served` beacon, so it costs no quota (CLAUDE.md 7.1).
      {%- endcomment -%}
      data-reco-serve="false"
      data-reco-source-product="*"
      {%- if mode == 'popular' %}
        data-reco-placement="popular"
        data-reco-source="shopify"
      {%- elsif mode == 'collection' %}
        data-reco-placement="collection"
        data-reco-source="shopify"
      {%- else %}
        data-reco-mode="recent"
        data-reco-placement="recently_viewed"
        data-reco-source="recently_viewed"
        {% if block.settings.exclude_current and product %}data-reco-exclude="{{ product.handle }}"{% endif %}
        {% if request.design_mode %}data-reco-design-mode="true"{% endif %}
      {%- endif %}
    {%- endif %}
    style="
      --reco-columns-desktop: {{ block.settings.columns_desktop }};
      --reco-columns-mobile: {{ block.settings.columns_mobile }};
      --reco-accent: {{ block.settings.accent_color }};
      {% if has_background %}--reco-background: {{ background }};{% endif %}
      --reco-padding-top: {{ block.settings.padding_top }}px;
      --reco-padding-bottom: {{ block.settings.padding_bottom }}px;
      --reco-ratio: {% case block.settings.image_ratio %}{% when 'square' %}1/1{% when 'portrait' %}3/4{% else %}auto{% endcase %};
      --reco-card-border: {% if block.settings.show_border %}1px{% else %}0px{% endif %};
    "
    {{ block.shopify_attributes }}
  >
    {%- if heading != blank -%}
      <h2 class="reco__heading reco__heading--{{ block.settings.heading_size }}">
        {{ heading }}
      </h2>
    {%- endif -%}

    <div class="reco__viewport">
      <div class="reco__track" data-reco-track>{{ cards }}</div>

      {%- if block.settings.layout == 'slider' -%}
        <div class="reco__nav" data-reco-nav hidden>
          <button
            type="button"
            class="reco__nav-button"
            data-reco-prev
            aria-label="{{ 'recommendations.previous' | t }}"
          >
            &#8249;
          </button>
          <button
            type="button"
            class="reco__nav-button"
            data-reco-next
            aria-label="{{ 'recommendations.next' | t }}"
          >
            &#8250;
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- if mode == 'recently_viewed' and request.design_mode -%}
      {%- comment -%} Editor only: an empty history here is normal, not a fault. {%- endcomment -%}
      <div class="reco--empty" data-reco-design-hint>
        <p>{{ 'recently_viewed.empty' | t }}</p>
      </div>
    {%- endif -%}

    {%- if client_rendered -%}
      {%- comment -%} Cloned by reco.js for each product it loads. {%- endcomment -%}
      <template data-reco-card-template>
        <div class="reco-card" data-reco-card>
          <a class="reco-card__media" data-reco-link>
            <img class="reco-card__image" width="400" height="400" loading="lazy" alt="">
          </a>
          <div class="reco-card__info">
            {%- if block.settings.show_vendor -%}
              <span class="reco-card__vendor" data-reco-vendor></span>
            {%- endif -%}
            {%- if block.settings.show_title -%}
              <a class="reco-card__title" data-reco-link data-reco-title></a>
            {%- endif -%}
            {%- if block.settings.show_price -%}
              <span class="reco-card__price">
                <span data-reco-price></span>
                {%- if block.settings.show_compare_price -%}
                  <s class="reco-card__compare" data-reco-compare hidden></s>
                {%- endif -%}
              </span>
            {%- endif -%}
            {%- if block.settings.show_add_to_cart -%}
              <button
                type="button"
                class="reco-card__button reco-card__button--{{ block.settings.button_style }}"
                data-reco-add
              >
                {{ add_label }}
              </button>
            {%- endif -%}
          </div>
        </div>
      </template>
    {%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <div class="reco reco--empty" {{ block.shopify_attributes }}>
    <p>
      {%- if mode == 'custom' or mode == 'related' -%}
        {{ 'recommendations.needs_product' | t }}
      {%- elsif mode == 'collection' and collection_blank -%}
        {{ 'collection.needs_collection' | t }}
      {%- elsif mode == 'collection' -%}
        {{ 'collection.empty' | t }}
      {%- else -%}
        {{ 'popular.empty' | t }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}
